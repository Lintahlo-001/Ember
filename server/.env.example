# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key

# Postgres (Supabase pooler, transaction mode, port 6543)
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@your-pooler-host.pooler.supabase.com:6543/postgres

# Server
PORT=3000
NODE_ENV=development
# Comma-separated browser origins allowed by CORS (native app sends none)
CORS_ORIGINS=http://localhost:8081

# POKEWALLET
POKEWALLET_API_KEY=pk_live_your_key_here

# CRON
CRON_SECRET=generate-a-long-random-string
